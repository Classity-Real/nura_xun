#!/bin/sh
[ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR=/run/user/$(id -u)

# Keep the desktop locale English regardless of the build host or old rootfs
# locale defaults. Leave LC_ALL unset so individual locale categories work.
export LANG=en_US.UTF-8
export LANGUAGE=en
unset LC_ALL

# Use the US keyboard layout; do not force the Chinese Pinyin input method.
export GTK_IM_MODULE=
export QT_IM_MODULE=
export XMODIFIERS=

if command -v gsettings >/dev/null 2>&1; then
	gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us')]" 2>/dev/null || true
	gsettings set org.gnome.desktop.input-sources mru-sources "[('xkb', 'us')]" 2>/dev/null || true
fi

export XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}
exec /usr/bin/gnome-session.real "$@" >>/tmp/session.log 2>&1
