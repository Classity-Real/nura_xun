# FocalTech FT8203 on Redmi Pad SE (xun)
# Kernel reports landscape coords after CCW map. If the pointer is still
# wrong, uncomment ONE matrix, reload udev, and re-test (no kernel rebuild).
#
# identity (kernel already mapped):
# ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 1 0"
#
# swap axes:
# ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 1 0 0"
#
# invert X:
# ENV{LIBINPUT_CALIBRATION_MATRIX}="-1 0 1 0 1 0"
#
# invert Y:
# ENV{LIBINPUT_CALIBRATION_MATRIX}="1 0 0 0 -1 1"
#
# 90 CW:
# ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1"
#
# 90 CCW (left_side_up style):
# ENV{LIBINPUT_CALIBRATION_MATRIX}="0 -1 1 1 0 0"

ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="Focaltech FT8203*", \
  ENV{ID_INPUT_TOUCHSCREEN}="1"
