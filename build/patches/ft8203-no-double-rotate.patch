+		if (y > 1919)
+			y = 1919;
+		input_report_abs(input, ABS_MT_POSITION_X, x);
+		input_report_abs(input, ABS_MT_POSITION_Y, y);
 	}
 
 	input_report_key(input, BTN_TOUCH, touch);
@@ -578,9 +580,9 @@ static int ft8203_probe(struct spi_device *spi)
