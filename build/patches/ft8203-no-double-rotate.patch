+		 * Native panel portrait space (1200x1920).
+		 * DTS: panel_orientation=left_side_up — Mutter/libinput rotate.
+		 * Rotating here as well double-transforms and breaks touch.
 		 */
 		x = x * 1200 / FT8203_RAW_WIDTH;
