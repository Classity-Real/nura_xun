--- a/initramfs/init
+++ b/initramfs/init
@@ -15,2 +15,2 @@
-# The same USB gadget is also an ECM network card (the tablet used as host
-# has cdc_ether but no cdc_acm): the phone is 172.16.42.1, hands out
+# The same USB gadget is also an NCM network card (Windows 11 has an in-box
+# NCM driver): the phone is 172.16.42.1, hands out
@@ -106,2 +106,2 @@
 	mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" \
-		"$G/functions/ecm.usb0" "$G/functions/acm.usb0"
+		"$G/functions/ncm.usb0" "$G/functions/acm.usb0"
@@ -115,5 +115,5 @@
-	echo ECM+ACM >"$G/configs/c.1/strings/0x409/configuration"
+	echo NCM+ACM >"$G/configs/c.1/strings/0x409/configuration"
 	# Fixed addresses, so the host keeps the same interface name
-	echo 02:7a:70:61:73:01 >"$G/functions/ecm.usb0/dev_addr"
-	echo 02:7a:70:61:73:02 >"$G/functions/ecm.usb0/host_addr"
-	ln -sfn "$G/functions/ecm.usb0" "$G/configs/c.1/ecm.usb0"
+	echo 02:7a:70:61:73:01 >"$G/functions/ncm.usb0/dev_addr"
+	echo 02:7a:70:61:73:02 >"$G/functions/ncm.usb0/host_addr"
+	ln -sfn "$G/functions/ncm.usb0" "$G/configs/c.1/ncm.usb0"
@@ -134,1 +134,1 @@
-	ifname=$(cat "$G/functions/ecm.usb0/ifname" 2>/dev/null)
+	ifname=$(cat "$G/functions/ncm.usb0/ifname" 2>/dev/null)
